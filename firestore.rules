rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin escape hatch. Mirror of `ADMIN_UID` in the client Info.plist
    // (read by `AuthService.isAdmin`). Update both when rotating admins.
    // TODO: replace the literal with your admin Firebase UID before deploy.
    function isAdmin() {
      return signedIn() && request.auth.uid == "A7waeoywDgdauEvQk3SsjPRYzPg2";
    }

    function postAuthorId(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.authorId;
    }

    function isFriend(otherUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(otherUid));
    }

    /// In a sorted 2-element participant array, the "other" user is whichever
    /// entry isn't the caller. Used to enforce friend-only conversation
    /// creation without indexing tricks rules don't support.
    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    function canReadPost(postId) {
      let author = postAuthorId(postId);
      return isSelf(author) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(author));
    }

    // Places — read by any signed-in user (the picker, the map, Discover
    // all need this). Counter fields (`globalVisitCount`,
    // `globalEngagementCount`) are bumped by Firestore triggers that use
    // the admin SDK and bypass these rules. Direct client writes are
    // denied for everyone *except* the configured admin UID, which can
    // create/edit places via `AdminAddView` and curate Creator's Pick via
    // `CreatorPicksAdminView`.
    match /places/{placeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;

      match /friends/{friendUid} {
        // Read for self + that specific friend (so a friend can verify
        // the relationship exists when reading posts/conversations).
        allow read: if signedIn() && (isSelf(uid) || request.auth.uid == friendUid);
        // Phase 4: friend graph mutations are server-owned. Acceptance
        // and removal both run through callables (`acceptFriendRequest`,
        // `removeFriend`) that enforce the 20-friend cap and write both
        // sides atomically. Direct client writes are denied so the cap
        // can't be bypassed.
        allow write: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isSelf(uid);
      }

      // Per-user, per-place "visit session" docs. The Cloud Function
      // creates/refreshes them on post-tag (admin SDK, bypasses these
      // rules); the client only needs to flip `closed: true` when the
      // user moves out of the place's vicinity. Owner-only.
      match /visits/{placeId} {
        allow read, write: if isSelf(uid);
      }

      // Moderation block list. The owner reads this so the client-side
      // filter can hide blocked authors' posts and conversations the
      // instant a block is applied. Writes are server-owned — the
      // `blockUser` / `unblockUser` callables use the admin SDK to write
      // both the block doc and tear down the friendship in one batch.
      // Without this rule, the SocialService snapshot listener silently
      // failed and the in-app filter never updated.
      match /blockedUsers/{blockedUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Server-written Discover cache (friend-of-friend + trending). The
      // `discoverFeed` callable uses the admin SDK to write payload+expiresAt
      // here; the owner can read it as a diagnostic affordance, but the
      // client normally just calls the callable and consumes the response.
      match /discover/{docId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Owner-only private profile fields — birthdate, ToS/Privacy consent
    // timestamps, deletion request marker, future phone number. Split out
    // from `users/{uid}` (which friends can read) so this sensitive data
    // is never exposed across the friend graph.
    match /userPrivate/{uid} {
      allow read, write: if isSelf(uid);
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if signedIn() &&
        resource.data.toUid == request.auth.uid;
      // Sender may cancel (delete) their own still-pending request.
      allow delete: if signedIn()
        && resource.data.fromUid == request.auth.uid
        && resource.data.status == "pending";
    }

    // 1:1 conversations between friends. Document id is the deterministic
    // sorted-uid pair joined by underscore. Participants arrays are
    // immutable; only `lastMessage*` fields update on send.
    match /conversations/{convId} {
      // Split get vs list:
      //  - get: a single-doc fetch. Allow when the doc DOESN'T exist (so
      //    `findOrCreateConversation`'s existence check can return "doesn't
      //    exist" rather than permission-denied) OR when the caller is in
      //    the participants. Conv ids are deterministic from the two uids,
      //    which are knowable anyway, so exposing "is there a conv here?"
      //    leaks nothing material.
      //  - list: a collection-level query. Listed docs always exist, so we
      //    just require the caller be a participant. The conversations
      //    listener in ConversationService filters by participantIds
      //    arrayContains me anyway, so every doc that comes back satisfies
      //    this naturally.
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/conversations/$(convId))
        || request.auth.uid in resource.data.participantIds
      );
      allow list: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && isFriend(otherParticipant(request.resource.data.participantIds));
      // Updates can't mutate participants. Only the recency/preview fields
      // change, and the writer must already be one of the participants.
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        // Messages are otherwise immutable, with three narrow exceptions:
        //  1. the `reactions` map — iMessage-style per-uid reaction toggles,
        //     editable by any conversation participant;
        //  2. the `emoji` field on a *reaction-mirror* message, editable only
        //     by its own sender (one reaction per post — see mirrorReaction); and
        //  3. a sender soft-deleting (unsending) their OWN message: setting
        //     `deleted: true` and blanking `text`. Hard deletes stay disabled
        //     below, so this tombstone is the only unsend path; `deleted` can
        //     only ever be set true, never reverted.
        // Everything else (`senderId`, `createdAt`, `kind`, …) stays locked.
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            || (
              resource.data.kind == 'reaction'
              && resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji'])
            )
            || (
              resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'text'])
              && request.resource.data.deleted == true
            )
          );
        allow delete: if false;
      }
    }

    match /posts/{postId} {
      // Read by author, by friends, OR by anyone when the post has been
      // marked discoverable (the implicit consent gate set by the on-device
      // PostClassifier — see CafeHunter/Shared/PostClassifier.swift).
      // Discoverable posts power the public Discover surface; everything
      // else stays inside the friend graph.
      allow read: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(resource.data.authorId)) ||
        resource.data.discoverable == true
      );
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /reactions/{reactorUid} {
        allow read: if signedIn() && canReadPost(postId);
        allow create, update: if signedIn()
          && request.auth.uid == reactorUid
          && canReadPost(postId);
        allow delete: if signedIn() && request.auth.uid == reactorUid;
      }
    }

    // UGC moderation reports. Writes always go through the `reportContent`
    // callable (admin SDK) so we can validate `targetType` ∈ {user, post,
    // message}, sanitize `details`, and stamp `status: "open"`. Direct
    // client access is denied — reviewers read these via the admin
    // console only.
    match /reports/{reportId} {
      allow read, write: if false;
    }
  }
}
