// Sample secrets file — committed to git as a template.
//
// First-time setup on a fresh clone:
//   1. cp Secrets.xcconfig.sample Secrets.xcconfig
//   2. Replace the placeholder with the real Google Maps Places API key
//      (ask the project owner; key is restricted to bundle ID
//      TechVision.CafeHunter so it's useless outside this app).
//   3. Secrets.xcconfig is in .gitignore so your key will never be committed.

GMS_PLACES_API_KEY = REPLACE_WITH_YOUR_PLACES_API_KEY

// Spotify "soundtrack your post" feature.
//   1. Create an app at https://developer.spotify.com/dashboard
//   2. Add redirect URI exactly: cafehunter-spotify://callback
//   3. Copy the Client ID below (PKCE flow — no client secret is used).
//   4. While the app is in Development Mode, add each poster's Spotify
//      account email under Settings → User Management (25-user cap).
SPOTIFY_CLIENT_ID = REPLACE_WITH_YOUR_SPOTIFY_CLIENT_ID
